# Port du serveur NestJS (par defaut 3001)
PORT=3001
NODE_ENV=development

# Base de donnees : 'postgres' (sur AWS RDS) ou 'sqlite' (local par defaut)
DB_TYPE=sqlite
DB_FILE=helpdesk.sqlite

# Configuration PostgreSQL (Active quand DB_TYPE=postgres)
# Exemples pour RDS AWS :
# DB_HOST=helpdesk-db.xxxxxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=MonMotDePasseSecret123
# DB_NAME=helpdesk
# DB_SSL=true

# Securite JWT
JWT_SECRET=replace-with-a-secure-random-secret
JWT_EXPIRES_IN=24h
# Stockage S3 pour pieces jointes (optionnel, sinon stockage local uploads/)
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=helpdesk-attachments-private
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
