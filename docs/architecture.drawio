        <mxCell id="B3ttknfcdw7w6ybPzpYb-173" parent="1" style="shape=mxgraph.aws4.rds;sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C9FE6;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;pointerEvents=1;" value="Standby Multi-AZ&lt;br&gt;non accessible · failover via DNS" vertex="1">
